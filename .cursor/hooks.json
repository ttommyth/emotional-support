{
  "version": 1,
  "hooks": {
    "beforeReadFile": [
      { "command": "node ./hooks/emotional-support-hook.js" }
    ],
    "afterFileEdit": [
      { "command": "node ./hooks/emotional-support-hook.js" }
    ],
    "afterAgentThought": [
      { "command": "node ./hooks/emotional-support-hook.js" }
    ],
    "beforeSubmitPrompt": [
      { "command": "node ./hooks/emotional-support-hook.js" }
    ],
    "postToolUseFailure": [
      { "command": "node ./hooks/emotional-support-hook.js" }
    ],
    "afterAgentResponse": [
      { "command": "node ./hooks/emotional-support-hook.js" }
    ]
  }
}
