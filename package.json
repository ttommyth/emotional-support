{
  "name": "emotional-support",
  "displayName": "Emotional Support",
  "description": "Emotional Support companion panel for VS Code-based IDEs",
  "repository": {
    "type": "git",
    "url": "https://github.com/ttommyth/emotional-support.git"
  },
  "publisher": "problemsofa",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:emotional-support.petView",
    "onView:emotional-support.controlView",
    "onCommand:emotional-support.setPetMood"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "emotional-support",
          "title": "Emotional Support",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "emotional-support": [
        {
          "id": "emotional-support.petView",
          "name": "Emotional Support",
          "type": "webview"
        },
        {
          "id": "emotional-support.controlView",
          "name": "Control Panel",
          "type": "webview",
          "when": "emotional-support.isDev"
        }
      ]
    },
    "commands": [
      {
        "command": "emotional-support.setPetMood",
        "title": "Emotional Support: Cycle Emotional Support Mood (Demo)"
      }
      ,
      {
        "command": "emotional-support.showOutput",
        "title": "Emotional Support: Show Output"
      },
      {
        "command": "emotional-support.clearOutput",
        "title": "Emotional Support: Clear Output"
      }
      ,
      {
        "command": "emotional-support.installUserHook",
        "title": "Emotional Support: Install user-level Cursor hook"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "emotional-support.mcp",
        "label": "Emotional Support MCP Server"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run build:webview && npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "build:webview": "npm --prefix webview-ui run build",
    "watch:webview": "npm --prefix webview-ui run build -- --watch",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run build:webview && npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.52.0",
    "eslint": "^9.39.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "zod": "^4.0.0"
  }
}
